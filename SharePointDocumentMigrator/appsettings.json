{
  "Logging": {
    "LogLevel": {
      "Default": "Information"
    },
    "File": {
      "Directory": "logs"
    }
  },
  "Authentication": {
    "TenantId": "",
    "ClientId": "",
    "UseDeviceCode": false, // if true requires authentication with device code in browser, otherwise uses client credentials flow (app-only)
    "ClientSecret": "", // need value if UseDeviceCode is false 00000000-0000-0000-0000-000000000000
    "Scopes": [
      "https://graph.microsoft.com/Sites.ReadWrite.All",
      "https://graph.microsoft.com/Files.ReadWrite.All",
      "https://graph.microsoft.com/User.Read"
    ]
  },
  "Migration": {
    "Source": {
      "Hostname": "contoso.sharepoint.com",
      "SitePath": "",
      "LibraryName": "",
      "RootFolder": "" 
    },
    "Target": {
      "Hostname": "contoso.sharepoint.com",
      "SitePath": "",
      "LibraryName": "",
      "RootFolder": ""
    },
    "DryRun": false,
    "OverwriteExistingFiles": true,
    "EnableMetadataMigration": true,
    "MetadataFieldMappings": {
      // "SourceFieldInternalName": "TargetFieldInternalName"
    },
    "MaxRetryCount": 5,
    "UploadChunkSizeKiB": 3200
  }
}